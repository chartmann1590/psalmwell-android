rules_version = '2';

// Psalmwell Firestore rules.
// Reflections and reports are written only by the Psalmwell API (service account), which moderates
// every post. Clients can read visible reflections, delete their own, and manage their own
// profile and blocked list. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 40; }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt', 'rulesAcceptedVersion', 'rulesAcceptedAt'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('displayName' in request.resource.data) || validName(request.resource.data.displayName))
        && (!('rulesAcceptedVersion' in request.resource.data) || request.resource.data.rulesAcceptedVersion is int);

      match /blocked/{targetUid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && targetUid != uid
          && request.resource.data.keys().hasOnly(['name', 'blockedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      }
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.displayName);
    }

    // Only approved reflections are stored here; the API moves removed ones out of this collection.
    match /days/{dayKey}/reflections/{reflectionId} {
      allow read: if true;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow create, update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
